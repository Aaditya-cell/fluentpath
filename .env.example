# Copy this file to .env only if you do not already have one.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
PORT=8001
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
# Server-only: needed to enable account deletion. Never return this key to the browser.
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
# Set true on a hosted project after running supabase/setup.sql. Keep false for local guest practice.
REQUIRE_AUTH_FOR_AI=false
